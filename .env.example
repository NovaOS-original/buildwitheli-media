# Server
PORT=4000
APP_ORIGIN=http://localhost:5173
VITE_API_ORIGIN=http://localhost:4000
NODE_ENV=development

# Firebase Admin SDK (use a service account in local development only)
FIREBASE_PROJECT_ID=buildwitheli-media
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=buildwitheli-media.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=buildwitheli-media
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=973033606621

# Owner authorization: set the Firebase Authentication UID after creating and verifying your owner account.
OWNER_FIREBASE_UID=
VITE_OWNER_FIREBASE_UID=

# Paystack TEST keys only during development
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
SUBSCRIPTION_PRICE_GHS=30

# Supabase Storage (server-only; never expose the service-role key to Vite)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
