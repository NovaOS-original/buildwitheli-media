rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.uid == 'REPLACE_WITH_OWNER_FIREBASE_UID'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || owner());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','status','subscription']);
      allow delete: if owner();
    }
    match /posts/{postId} {
      allow read: if resource.data.status == 'PUBLISHED' || (signedIn() && resource.data.uid == request.auth.uid) || owner();
      allow write: if false;
    }
    match /subscriptions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || owner());
      allow write: if false;
    }
    match /transactions/{id} { allow read: if owner(); allow write: if false; }
    match /moderationHistory/{id} { allow read: if owner(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
